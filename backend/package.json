{
  "name": "wizfield-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "echo \"No backend lint configured\"",
    "typeorm": "node -r ts-node/register ./node_modules/typeorm/cli.js -d src/database/data-source.ts",
    "migration:generate": "node -r ts-node/register ./node_modules/typeorm/cli.js -d src/database/data-source.ts migration:generate src/database/migrations/active/auto",
    "migration:run": "node -r ts-node/register ./node_modules/typeorm/cli.js -d src/database/data-source.ts migration:run",
    "migration:revert": "node -r ts-node/register ./node_modules/typeorm/cli.js -d src/database/data-source.ts migration:revert",
    "schema:verify": "node -r ts-node/register src/database/verify-schema.ts",
    "schema:smoke": "node -r ts-node/register src/database/schema-smoke-test.ts",
    "language-store-billing-dev:smoke": "node -r ts-node/register src/database/language-store-billing-projection-smoke.ts",
    "language-store-entitlement:smoke": "node -r ts-node/register src/database/language-store-entitlement-reprojection-smoke.ts",
    "language-store-preference:smoke": "node -r ts-node/register src/database/language-store-preference-isolation-smoke.ts",
    "language-store-translation:smoke": "node -r ts-node/register src/database/language-store-translation-engine-smoke.ts",
    "language-store-snapshot-safety:smoke": "node -r ts-node/register src/database/document-snapshot-translation-safety-smoke.ts",
    "inspections:isolation:smoke": "node -r ts-node/register src/database/inspections-org-isolation-smoke.ts",
    "document-snapshot:isolation:smoke": "node -r ts-node/register src/database/document-snapshot-org-isolation-smoke.ts",
    "telephony-messaging:isolation:smoke": "node -r ts-node/register src/database/telephony-messaging-org-isolation-smoke.ts",
    "public-booking:isolation:smoke": "node -r ts-node/register src/database/public-booking-org-isolation-smoke.ts",
    "portal:scope-check": "node -r ts-node/register src/customer-portal/portal-scope-unit-check.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/typeorm": "^11.0.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "mysql2": "^3.15.2",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^22.1.1",
    "typeorm": "^0.3.25"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.50",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
