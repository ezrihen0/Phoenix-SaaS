BACKEND_PORT=4000
# Comma-separated browser origins. In dev, 192.168.x / 10.x LAN origins are also allowed automatically.
CORS_ORIGIN=http://localhost:3000

DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=wizfield
DB_PASSWORD=wizfield
DB_NAME=wizfield
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=false
DB_LOGGING=false

# Database isolation smoke tests (e.g. `npm run telephony-messaging:isolation:smoke`) create a throwaway DB
# named `wizfield_tel_msg_verify_*`, run migrations, then tear down. The DB user must be able to CREATE that
# database and run migrations inside it (often `GRANT CREATE, DROP ON *.*`, plus `ALL PRIVILEGES` on wildcards
# or `*.*` for dev — narrow this in shared/staging environments). Docker-only `MYSQL_USER` accounts that
# only hold `wizfield` will fail until an admin grants those rights.

SESSION_COOKIE_NAME=wizfield_session
SESSION_TTL_HOURS=168
SESSION_COOKIE_SECURE=false

# Stripe — WizField billing (shared billing account; Stripe Checkout + webhook sync)
# Frontend publishable key lives in frontend/.env.example as NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=price_1TWuElJxcL9VShfS7guDupz6
STRIPE_PRICE_PRO=price_1TWuFlJxcL9VShfSZb5Ed22o
STRIPE_PRICE_BUSINESS=price_1TWuG3JxcL9VShfSXRLGf116
STRIPE_PRICE_LANGUAGE_SLOT_PACK=
STRIPE_PRICE_TRANSLATION_USAGE_PACK=
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/billing/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/pricing?checkout=cancelled

# Gemini — Language Store customer English output provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Clover — historical / parked for Gate 13 after the Stripe-first switch.
# Keep only if you need the old sandbox references during audit or rollback analysis.
# CLOVER_API_BASE_URL=https://apisandbox.dev.clover.com
# CLOVER_MERCHANT_ID=
# CLOVER_ACCESS_TOKEN=
# CLOVER_PLAN_ID_STARTER=
# CLOVER_PLAN_ID_PRO=
# CLOVER_PLAN_ID_BUSINESS=
# CLOVER_ECOMMERCE_API_BASE_URL=https://scl-sandbox.dev.clover.com
# CLOVER_ECOMMERCE_ACCESS_TOKEN=
# CLOVER_ECOMMERCE_PUBLIC_KEY=

BACKEND_BOOTSTRAP_ADMIN_EMAIL=admin@wizfield.local
BACKEND_BOOTSTRAP_ADMIN_PASSWORD=Admin12345!
BACKEND_BOOTSTRAP_ADMIN_NAME=WizField Admin

# --- Gate 12 / isolation smokes (optional; see docs/gate-12-recovery-verification-enablement.md) ---
# Isolation smokes use DB_HOST, DB_PORT, DB_USERNAME, DB_PASSWORD to open a server-level MySQL connection
# and run CREATE DATABASE on ephemeral verify DBs. The app user above may lack CREATE; for smoke runs only,
# point DB_USERNAME/DB_PASSWORD at a dedicated principal (e.g. local root or wizfield_smoke) with CREATE+DROP.
# DB_SMOKE_DATABASE=my_verify_db_once
# DB_SMOKE_DROP=true

# --- Growth Center · Phase 3 publishing integrations ---
# AES-256-GCM key for OAuth token encryption at rest (32 raw bytes, base64-encoded).
MARKETING_OAUTH_SECRET_KEY=
MARKETING_GOOGLE_CLIENT_ID=
MARKETING_GOOGLE_CLIENT_SECRET=
MARKETING_GOOGLE_REDIRECT_URI=http://localhost:4000/api/marketing/oauth/google/callback
MARKETING_META_APP_ID=
MARKETING_META_APP_SECRET=
MARKETING_META_REDIRECT_URI=http://localhost:4000/api/marketing/oauth/meta/callback
MARKETING_PUBLIC_APP_ORIGIN=http://localhost:3000
MARKETING_PUBLISH_DISPATCHER_ENABLED=true

# --- AI program Phases 0–4 (see docs/WizField_AI_Master_Source_of_Truth.md) ---
# Enabling tokens: true, 1, yes, on (case-insensitive). Parent gates must be on before children.

# Phase 0 — all /api/ai parent gate (403 ai_foundation_disabled when off).
AI_FOUNDATION_ENABLED=

# Phase 1 — Brain home brief (403 ai_brain_v1_disabled when foundation on but this off).
AI_BRAIN_V1_ENABLED=

# Phase 1.5A — staff call-intake dry-run; also required for post-call webhook finalize (not live pilot).
AI_VOICE_INTAKE_FOUNDATION_ENABLED=

# Phase 1.5B — live Telnyx AI attach only (post-call finalize does NOT require this flag).
AI_VOICE_INTAKE_LIVE_PILOT_ENABLED=
# Comma-separated owned_phone_numbers.id allowlist (required non-empty when pilot on — default deny).
AI_VOICE_INTAKE_LIVE_PILOT_OWNED_PHONE_IDS=
# Optional comma-separated organization UUID allowlist.
AI_VOICE_INTAKE_LIVE_PILOT_ORGANIZATION_IDS=

# Phase 2–4 — Operator Copilot (/calls SMS drafts, guarded send, outcome tracking).
AI_OPERATOR_COPILOT_ENABLED=
AI_COPILOT_CALLS_SURFACE_ENABLED=
AI_COPILOT_CUSTOMER_SMS_DRAFT_ENABLED=
# Optional LLM draft path (falls back to template when off or on failure).
AI_COPILOT_LLM_ENABLED=
OPENAI_API_KEY=
OPENAI_COPILOT_MODEL=
# Phase 3 — guarded send from Copilot (also requires messaging.send permission).
AI_COPILOT_CUSTOMER_SMS_GUARDED_SEND_ENABLED=
# Phase 4 — read-only outcome fields on sent drafts.
AI_COPILOT_CUSTOMER_SMS_OUTCOME_TRACKING_ENABLED=

# Amber Telnyx assistant id when voice_flows.telnyx_assistant_id is null (seed / ops).
VOICE_FLOW_AMBER_TELNYX_ASSISTANT_ID=

# Phase 1.5B P2 — Telnyx AI Assistant tool bridge (`get_availability`): POST `/telephony/telnyx/tools/get-availability`.
# Verifies the same Ed25519 signature headers as Telnyx voice webhooks (`telnyx-signature-ed25519`, `telnyx-timestamp`) using `TELNYX_PUBLIC_KEY`.
# Telnyx includes `x-telnyx-call-control-id` on tool requests for correlation to `recent_calls.provider_call_id`.
