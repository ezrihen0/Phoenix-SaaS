BACKEND_PORT=4000
CORS_ORIGIN=http://localhost:3001

DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=wizfield
DB_PASSWORD=wizfield
DB_NAME=wizfield
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=false
DB_LOGGING=false

SESSION_COOKIE_NAME=wizfield_session
SESSION_TTL_HOURS=168
SESSION_COOKIE_SECURE=false

# Stripe — WizField billing (shared billing account; Stripe Checkout + webhook sync)
# Frontend publishable key lives in frontend/.env.example as NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=price_1TWuElJxcL9VShfS7guDupz6
STRIPE_PRICE_PRO=price_1TWuFlJxcL9VShfSZb5Ed22o
STRIPE_PRICE_BUSINESS=price_1TWuG3JxcL9VShfSXRLGf116
STRIPE_PRICE_LANGUAGE_SLOT_PACK=
STRIPE_PRICE_TRANSLATION_USAGE_PACK=
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/billing/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/pricing?checkout=cancelled

# Clover — historical / parked for Gate 13 after the Stripe-first switch.
# Keep only if you need the old sandbox references during audit or rollback analysis.
# CLOVER_API_BASE_URL=https://apisandbox.dev.clover.com
# CLOVER_MERCHANT_ID=
# CLOVER_ACCESS_TOKEN=
# CLOVER_PLAN_ID_STARTER=
# CLOVER_PLAN_ID_PRO=
# CLOVER_PLAN_ID_BUSINESS=
# CLOVER_ECOMMERCE_API_BASE_URL=https://scl-sandbox.dev.clover.com
# CLOVER_ECOMMERCE_ACCESS_TOKEN=
# CLOVER_ECOMMERCE_PUBLIC_KEY=

BACKEND_BOOTSTRAP_ADMIN_EMAIL=admin@wizfield.local
BACKEND_BOOTSTRAP_ADMIN_PASSWORD=Admin12345!
BACKEND_BOOTSTRAP_ADMIN_NAME=WizField Admin

# --- Gate 12 / isolation smokes (optional; see docs/gate-12-recovery-verification-enablement.md) ---
# Isolation smokes use DB_HOST, DB_PORT, DB_USERNAME, DB_PASSWORD to open a server-level MySQL connection
# and run CREATE DATABASE on ephemeral verify DBs. The app user above may lack CREATE; for smoke runs only,
# point DB_USERNAME/DB_PASSWORD at a dedicated principal (e.g. local root or wizfield_smoke) with CREATE+DROP.
# DB_SMOKE_DATABASE=my_verify_db_once
# DB_SMOKE_DROP=true
