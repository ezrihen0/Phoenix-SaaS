BACKEND_PORT=4000
CORS_ORIGIN=http://localhost:3001

DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=phoenix
DB_PASSWORD=phoenix
DB_NAME=phoenix_crm
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=false
DB_LOGGING=false

SESSION_COOKIE_NAME=phoenix_session
SESSION_TTL_HOURS=168
SESSION_COOKIE_SECURE=false

# Clover — PhoenixOS SaaS billing (single merchant; org = Clover customer)
# CLOVER_API_BASE_URL=https://apisandbox.dev.clover.com
# CLOVER_MERCHANT_ID=
# CLOVER_ACCESS_TOKEN=
# CLOVER_PLAN_ID_STARTER=
# CLOVER_PLAN_ID_PRO=
# CLOVER_PLAN_ID_BUSINESS=
#
# Ecommerce (card-on-file / SCL) — separate from recurring host; used only for customer + token APIs.
# CLOVER_ECOMMERCE_API_BASE_URL=https://scl-sandbox.dev.clover.com
# CLOVER_ECOMMERCE_ACCESS_TOKEN=
# Public key from Clover ecommerce API tokens (safe for authenticated owner UI / Clover.js tokenization).
# CLOVER_ECOMMERCE_PUBLIC_KEY=

BACKEND_BOOTSTRAP_ADMIN_EMAIL=admin@phoenixcrm.local
BACKEND_BOOTSTRAP_ADMIN_PASSWORD=Admin12345!
BACKEND_BOOTSTRAP_ADMIN_NAME=Phoenix Admin

# --- Gate 12 / isolation smokes (optional; see docs/gate-12-recovery-verification-enablement.md) ---
# Isolation smokes use DB_HOST, DB_PORT, DB_USERNAME, DB_PASSWORD to open a server-level MySQL connection
# and run CREATE DATABASE on ephemeral verify DBs. The app user above may lack CREATE; for smoke runs only,
# point DB_USERNAME/DB_PASSWORD at a dedicated principal (e.g. local root or phoenix_smoke) with CREATE+DROP.
# DB_SMOKE_DATABASE=my_verify_db_once
# DB_SMOKE_DROP=true
