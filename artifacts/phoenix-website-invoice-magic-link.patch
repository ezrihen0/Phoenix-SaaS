@@ -0,0 +1,43 @@
+import { NextResponse } from "next/server";
+
+import {
+  encodePortalSessionCookieValue,
+  PORTAL_SESSION_COOKIE_NAME,
+  portalSessionCookieOptions,
+} from "@/lib/portal/session-cookie";
+import { redeemPortalMagicLinkOnWizfield } from "@/lib/portal/wizfield-portal-client";
+
+export const dynamic = "force-dynamic";
+
+export async function POST(request: Request) {
+  let token = "";
+
+  try {
+    const payload = (await request.json()) as { token?: unknown };
+    token = typeof payload.token === "string" ? payload.token.trim() : "";
+  } catch {
+    token = "";
+  }
+
+  if (!token) {
+    return NextResponse.json({ ok: false, message: "This sign-in link is not valid." }, { status: 400 });
+  }
+
+  const redeemed = await redeemPortalMagicLinkOnWizfield(token);
+  if (!redeemed.ok) {
+    return NextResponse.json({ ok: false, message: redeemed.message }, { status: redeemed.status });
+  }
+
+  const response = NextResponse.json({
+    ok: true,
+    redirect_path: redeemed.redirect_path,
+  });
+
+  response.cookies.set(
+    PORTAL_SESSION_COOKIE_NAME,
+    encodePortalSessionCookieValue(redeemed.session_token),
+    portalSessionCookieOptions(redeemed.session_expires_at),
+  );
+
+  return response;
+}
