+  params: Promise<{ token: string }>;
+};
+
+export default async function LegacyPortalAccessPage({ params }: LegacyPortalAccessPageProps) {
+  const { token } = await params;
+  const normalizedToken = token?.trim();
+
+  if (!normalizedToken) {
+    redirect("/portal/login");
+  }
+
