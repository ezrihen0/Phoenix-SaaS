+import "server-only";
+
+import { isWizfieldConfigured } from "@/lib/wizfield/client";
+
+const REDEEM_ERROR_MESSAGES: Record<string, string> = {
+  invalid_link: "This sign-in link is not valid.",
+  expired_link: "This sign-in link has expired.",
+  used_link: "This sign-in link has already been used.",
+  portal_link_redeem_race: "This sign-in link is no longer available.",
+};
+
+function readEnv(name: string) {
+  return process.env[name]?.trim() || "";
+}
+
+function getWizfieldPortalConfig() {
+  if (!isWizfieldConfigured()) {
+    return null;
+  }
+
+  const baseUrl = readEnv("WIZFIELD_API_BASE_URL").replace(/\/+$/, "");
+  const secret = readEnv("WIZFIELD_INTEGRATION_SECRET");
+  if (!baseUrl || !secret) {
+    return null;
+  }
+
+  return { baseUrl, secret };
+}
+
+function resolveOrganizationId() {
+  return (
+    readEnv("PHOENIX_INTEGRATION_ORGANIZATION_ID")
+    || readEnv("PHOENIX_WIZFIELD_ORGANIZATION_ID")
+    || readEnv("WIZFIELD_ORGANIZATION_ID")
+  );
+}
+
+function unwrapApiData<T>(body: unknown): T | null {
+  if (!body || typeof body !== "object") {
+    return null;
+  }
+
+  const record = body as { data?: unknown };
+  if (record.data && typeof record.data === "object") {
+    return record.data as T;
+  }
+
+  return body as T;
+}
+
+function redeemErrorMessage(body: unknown, fallback: string) {
+  if (body && typeof body === "object") {
+    const error = (body as { error?: { code?: string; message?: string } }).error;
+    if (error?.code && REDEEM_ERROR_MESSAGES[error.code]) {
+      return REDEEM_ERROR_MESSAGES[error.code];
+    }
+    if (typeof error?.message === "string" && error.message.trim()) {
+      return error.message.trim();
+    }
+  }
+
+  return fallback;
+}
+
+export type RedeemPortalMagicLinkResult =
+  | {
+      ok: true;
+      session_token: string;
+      session_expires_at: string;
+      redirect_path: string;
+    }
+  | {
+      ok: false;
+      status: number;
+      message: string;
+    };
+
+export async function redeemPortalMagicLinkOnWizfield(rawToken: string): Promise<RedeemPortalMagicLinkResult> {
+  const config = getWizfieldPortalConfig();
+  if (!config) {
+    return {
+      ok: false,
+      status: 503,
+      message: "The customer portal is not connected yet. Try again later or call Phoenix.",
+    };
+  }
+
+  const token = rawToken.trim();
+  if (!token) {
+    return { ok: false, status: 400, message: "This sign-in link is not valid." };
+  }
+
+  const response = await fetch(`${config.baseUrl}/api/portal/auth/redeem`, {
+    method: "POST",
+    headers: {
+      Authorization: `Bearer ${config.secret}`,
+      "Content-Type": "application/json",
+      Accept: "application/json",
+    },
+    body: JSON.stringify({ token }),
+    cache: "no-store",
+  });
+
+  let body: unknown = null;
+  try {
+    body = await response.json();
+  } catch {
+    body = null;
+  }
+
+  if (!response.ok) {
+    return {
+      ok: false,
+      status: response.status,
+      message: redeemErrorMessage(body, "This sign-in link could not be used."),
+    };
+  }
+
+  const data = unwrapApiData<{
+    session_token?: string;
+    session_expires_at?: string;
+    redirect_path?: string;
+  }>(body);
+
+  const sessionToken = typeof data?.session_token === "string" ? data.session_token.trim() : "";
+  const sessionExpiresAt =
+    typeof data?.session_expires_at === "string" ? data.session_expires_at.trim() : "";
+  const redirectPath =
+    typeof data?.redirect_path === "string" && data.redirect_path.trim()
+      ? data.redirect_path.trim()
+      : "/portal";
+
+  if (!sessionToken || !sessionExpiresAt) {
+    return {
+      ok: false,
+      status: 502,
+      message: "This sign-in link could not be used.",
+    };
+  }
+
+  return {
+    ok: true,
+    session_token: sessionToken,
+    session_expires_at: sessionExpiresAt,
+    redirect_path: redirectPath,
+  };
+}
+
+export async function requestPortalMagicLinkOnWizfield(email: string) {
+  const config = getWizfieldPortalConfig();
+  if (!config) {
+    return {
+      ok: false as const,
+      status: "deferred" as const,
+      message:
+        "The customer portal is prepared, but WizField is not connected yet. Job status, quotes, invoices, and documents will appear here after the adapter is live.",
+      emailDelivery: "skipped" as const,
+    };
+  }
+
+  const organizationId = resolveOrganizationId();
+  if (!organizationId) {
+    return {
+      ok: false as const,
+      status: "connected" as const,
+      message:
+        "Portal magic link is not enabled on WizField yet. Set PORTAL_ADAPTER_ENABLED after WizField routes are live.",
+      emailDelivery: "skipped" as const,
+    };
+  }
+
+  if (readEnv("PORTAL_ADAPTER_ENABLED").toLowerCase() !== "true") {
+    return {
+      ok: false as const,
+      status: "connected" as const,
+      message:
+        "Portal magic link is not enabled on WizField yet. Set PORTAL_ADAPTER_ENABLED after WizField routes are live.",
+      emailDelivery: "skipped" as const,
+    };
+  }
+
+  const response = await fetch(`${config.baseUrl}/api/integrations/phoenix/portal/magic-link`, {
+    method: "POST",
+    headers: {
+      Authorization: `Bearer ${config.secret}`,
+      "Content-Type": "application/json",
+      Accept: "application/json",
+    },
+    body: JSON.stringify({ organizationId, email }),
+    cache: "no-store",
+  });
+
+  if (!response.ok) {
+    return {
+      ok: false as const,
+      status: "connected" as const,
+      message: "Sign-in is not available yet. Try again later or call Phoenix.",
+      emailDelivery: "skipped" as const,
+    };
+  }
+
+  return {
+    ok: true as const,
+    status: "connected" as const,
+    message: "If that email is on file, check your inbox for a sign-in link.",
+    emailDelivery: "sent" as const,
+  };
+}
+
+export function isPortalAdapterEnabled() {
+  return isWizfieldConfigured() && readEnv("PORTAL_ADAPTER_ENABLED").toLowerCase() === "true";
+}
