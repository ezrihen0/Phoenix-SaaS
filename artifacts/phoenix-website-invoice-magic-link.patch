@@ -0,0 +1,139 @@
+"use client";
+
+import { useCallback, useEffect, useRef, useState } from "react";
+import { useRouter } from "next/navigation";
+
+import { trackPortalEvent } from "@/lib/analytics/events";
+
+type PortalMagicLinkConfirmProps = {
+  token: string;
+  autoRedeem?: boolean;
+};
+
+type RedeemResponse = {
+  ok?: boolean;
+  message?: string;
+  redirect_path?: string;
+};
+
+const redeemInFlightTokens = new Set<string>();
+
+export function PortalMagicLinkConfirm({ token, autoRedeem = false }: PortalMagicLinkConfirmProps) {
+  const router = useRouter();
+  const [error, setError] = useState<string | null>(null);
+  const [state, setState] = useState<"idle" | "submitting" | "done">("idle");
+  const redeemStartedRef = useRef(false);
+
+  const redeem = useCallback(async () => {
+    if (!token) {
+      setError("This sign-in link is missing a token. Request a new link from the login page.");
+      return;
+    }
+
+    if (redeemInFlightTokens.has(token)) {
+      return;
+    }
+
+    redeemInFlightTokens.add(token);
+    setState("submitting");
+    setError(null);
+
+    try {
+      const response = await fetch("/api/portal/auth/redeem", {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ token }),
+      });
+      const body = (await response.json()) as RedeemResponse;
+
+      if (!response.ok || !body.ok) {
+        setError(body.message || "This sign-in link could not be used.");
+        setState("idle");
+        redeemInFlightTokens.delete(token);
+        return;
+      }
+
+      setState("done");
+      trackPortalEvent("portal_login_success");
+
+      const redirectPath =
+        typeof body.redirect_path === "string" && body.redirect_path.trim()
+          ? body.redirect_path.trim()
+          : "/portal";
+      router.replace(redirectPath);
+      router.refresh();
+    } catch {
+      setError("Something went wrong. Try again or request a new sign-in link.");
+      setState("idle");
+      redeemInFlightTokens.delete(token);
+    }
+  }, [router, token]);
+
+  useEffect(() => {
+    if (!autoRedeem || !token) {
+      return;
+    }
+
+    if (redeemStartedRef.current) {
+      return;
+    }
+
+    redeemStartedRef.current = true;
+    void redeem();
+  }, [autoRedeem, redeem, token]);
+
+  if (!token) {
+    return (
+      <p className="rounded-2xl bg-[rgba(201,95,43,0.08)] px-4 py-3 text-sm text-[var(--color-muted)]">
+        This link is incomplete. Use Customer Login and request a new magic link.
+      </p>
+    );
+  }
+
+  if (autoRedeem) {
+    return (
+      <div className="grid gap-4">
+        {error ? (
+          <p className="rounded-2xl bg-[rgba(201,95,43,0.08)] px-4 py-3 text-sm text-[var(--color-muted)]">{error}</p>
+        ) : null}
+        <p className="text-sm leading-7 text-[var(--color-muted)]">
+          {state === "done"
+            ? "Redirecting to your invoice…"
+            : state === "submitting"
+              ? "Opening your invoice securely…"
+              : "Preparing secure access…"}
+        </p>
+        {error ? (
+          <button
+            type="button"
+            disabled={state === "submitting"}
+            onClick={() => {
+              redeemStartedRef.current = false;
+              redeemInFlightTokens.delete(token);
+              void redeem();
+            }}
+            className="inline-flex min-h-12 items-center justify-center rounded-full bg-[var(--color-ember)] px-5 text-sm font-semibold text-white disabled:opacity-70"
+          >
+            Try again
+          </button>
+        ) : null}
+      </div>
+    );
+  }
+
+  return (
+    <div className="grid gap-4">
+      {error ? (
+        <p className="rounded-2xl bg-[rgba(201,95,43,0.08)] px-4 py-3 text-sm text-[var(--color-muted)]">{error}</p>
+      ) : null}
+      <button
+        type="button"
+        disabled={state === "submitting" || state === "done"}
+        onClick={() => void redeem()}
+        className="inline-flex min-h-12 items-center justify-center rounded-full bg-[var(--color-ember)] px-5 text-sm font-semibold text-white disabled:opacity-70"
+      >
+        {state === "submitting" ? "Opening your portal…" : state === "done" ? "Redirecting…" : "Continue to my portal"}
+      </button>
+    </div>
+  );
+}
